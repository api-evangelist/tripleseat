{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/tripleseat/refs/heads/main/json-structure/tripleseat-api-contact-create-structure.json",
  "name": "ContactCreate",
  "description": "Fields accepted when creating a contact.",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "example": "Mark"
    },
    "last_name": {
      "type": "string",
      "example": "Lawrence"
    },
    "email_address": {
      "type": "string",
      "example": "contact@example.com"
    },
    "phone_number": {
      "type": "string",
      "example": "+1-555-867-5309"
    },
    "account_id": {
      "type": "int32",
      "description": "Identifier of the account to associate the contact with.",
      "example": 500123
    }
  },
  "required": [
    "first_name",
    "account_id"
  ]
}